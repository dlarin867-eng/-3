# Скопируй в .env и заполни реальными значениями. .env никогда не коммитить.

# --- Сервер ---
PORT=3001
NODE_ENV=development

# --- База данных (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@localhost:5432/kbzhu?schema=public"

# --- Аутентификация ---
JWT_SECRET="замени-на-длинную-случайную-строку"
JWT_EXPIRES_IN="7d"

# --- Claude API (распознавание еды по фото — блок 5) ---
ANTHROPIC_API_KEY=""

# --- Open Food Facts (штрихкоды — блок 5) ---
# Публичный API, ключ не нужен: https://world.openfoodfacts.org/data
OPEN_FOOD_FACTS_BASE_URL="https://world.openfoodfacts.org"

# --- USDA FoodData Central (сверка калорийности — блок 5) ---
USDA_FDC_API_KEY=""

# --- Хранилище фото (S3-совместимое, напр. Cloudflare R2) ---
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="kbzhu-meal-photos"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Срок хранения фото в днях до автоудаления (НФТ 5.3 — минимизация хранения)
PHOTO_RETENTION_DAYS=30
